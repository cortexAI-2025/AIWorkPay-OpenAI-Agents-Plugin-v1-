{
  "name": "aiworkpay-openai-agents-plugin",
  "version": "1.0.0",
  "description": "OpenAI Agents compatible plugin for AiWorkPay — delegate, pay, and validate human micro-tasks from any AI agent.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "example:basic": "ts-node examples/basic-agent.ts",
